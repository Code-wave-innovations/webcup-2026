VITE_BASE_URL=http://localhost:9002
VITE_API_URL=http://localhost:9002/api
VITE_IMG_URL=http://localhost:9002/public/
VITE_FACE_API_URL=http://localhost:9000
# Browser → face engine for identify / enroll (airlock + /face). Then the app opens the session with
# GET /api/auth/by-email. The key is public in the built JS: use a dedicated key and lock CORS on the
# face service to the frontend origin.
VITE_FACE_API_KEY=
VITE_STT_API_URL=http://localhost:9100
# Nova's voice (Swiftask text-to-speech). Visible in the built JavaScript: use a key with a usage limit.
SWIFTASK_API_KEY=

# Cloudflare Turnstile (public site key). Soft challenge on anonymous contact / register
# when the backend decides the submission looks automated. Leave empty in local dev.
# VITE_TURNSTILE_SITE_KEY=
