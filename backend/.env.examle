DATABASE_URL="mysql://user_name:password@server:port/database_name"
# PORT=9002
# ENV=development

# Required outside local dev: signs the auth tokens
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# D19: official Terra Nova API shown in the agent workspace (GET /api/terra-nova/requests)
TERRA_NOVA_API_URL="https://24h.webcup.fr/wp-json/webcup/v1/requests/"
TERRA_NOVA_API_TOKEN="s45f4ds5fgrtr4hytutyt45y4t54yty"

# Time zone used for timetables, slots and labels (defaults to the machine's)
# TZ="Indian/Reunion"

# Set to 1 when the app sits behind a proxy (cPanel/Passenger included) and
# GET /api/security/client-ip shows the visitor's IP in x_forwarded_for.
# Without it, per-IP rate limits and soft Turnstile thresholds are skipped.
# TRUST_PROXY=1

# Front-end origins allowed by CORS, comma-separated (every origin when unset)
# CORS_ORIGINS="https://novaterra.example,http://localhost:5173"

# Cloudflare Turnstile secret (server only — never VITE_*). When unset, honeypot +
# timing + hard rate limits still apply; soft challenges are skipped.
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY=
# D02: passkeys (WebAuthn). The relying party is the site's domain, the origins are the front-end
# URLs allowed to use it (comma-separated). WebAuthn needs HTTPS, except on localhost.
# WEBAUTHN_RP_ID="novaterra.example"
# WEBAUTHN_ORIGIN="https://novaterra.example"

# Password of the demo accounts created by `npm run seed`
SEED_PASSWORD="NovaTerra2026!"
