# DuckDNS: create a subdomain at https://www.duckdns.org
DOMAIN=myface.duckdns.org
# DuckDNS subdomain only (without .duckdns.org) — usually the left label of DOMAIN
DUCKDNS_SUBDOMAIN=myface
DUCKDNS_TOKEN=your-duckdns-token
LETSENCRYPT_EMAIL=you@example.com

FACE_API_KEY=change-me-to-a-long-random-secret
FACE_CORS_ORIGINS=https://myface.duckdns.org

FACE_MAX_UPLOAD_MB=8
FACE_RATE_LIMIT=60 per minute
FACE_VERIFY_THRESHOLD=0.45
FACE_IDENTIFY_THRESHOLD=0.40
FACE_LIVENESS_THRESHOLD=0.55
FACE_REQUIRE_LIVENESS_VERIFY=true
FACE_REQUIRE_LIVENESS_IDENTIFY=false
FACE_MIN_ENROLL_SAMPLES=3
FACE_MAX_ENROLL_SAMPLES=5
FACE_INSIGHTFACE_MODEL=buffalo_s
FACE_DET_SIZE=640
