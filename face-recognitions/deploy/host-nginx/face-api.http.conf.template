# Host nginx — phase 1 (before Let's Encrypt cert exists).
# Proxies public :80 → Docker nginx on 127.0.0.1:__HTTP_PORT__
# Install via: sudo ./deploy/host-nginx/install-host-nginx.sh

upstream face_docker {
    server 127.0.0.1:__HTTP_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 10m;

    location / {
        proxy_pass http://face_docker;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
