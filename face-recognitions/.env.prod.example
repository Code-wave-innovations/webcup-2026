# DuckDNS: create a subdomain at https://www.duckdns.org (optional if you own DNS)
DOMAIN=webcup.duckdns.org
DUCKDNS_SUBDOMAIN=webcup
DUCKDNS_TOKEN=your-duckdns-token
LETSENCRYPT_EMAIL=you@real-email.com

# --- Option 2: host nginx on :80/:443, Docker on high ports ---
# System nginx proxies public traffic → 127.0.0.1:HTTP_PORT
# FORCE_HTTP=1 keeps Docker nginx on plain HTTP (TLS on the host).
HTTP_PORT=84
HTTPS_PORT=447
FORCE_HTTP=1

# --- Option 1 (Docker owns 80/443): ---
# HTTP_PORT=80
# HTTPS_PORT=443
# FORCE_HTTP=0

FACE_API_KEY=change-me-to-a-long-random-secret
# Browser Origin = frontend URL (not the face API domain)
FACE_CORS_ORIGINS=https://codewave.madagascar.webcup.hodi.cloud

FACE_MAX_UPLOAD_MB=8
FACE_RATE_LIMIT="60 per minute"
FACE_VERIFY_THRESHOLD=0.45
FACE_IDENTIFY_THRESHOLD=0.40
FACE_LIVENESS_THRESHOLD=0.55
FACE_REQUIRE_LIVENESS_VERIFY=true
FACE_REQUIRE_LIVENESS_IDENTIFY=false
FACE_MIN_ENROLL_SAMPLES=3
FACE_MAX_ENROLL_SAMPLES=5
FACE_MIN_FACE_SIZE=80
FACE_MIN_SHARPNESS=35
FACE_INSIGHTFACE_MODEL=buffalo_s
FACE_DET_SIZE=640
