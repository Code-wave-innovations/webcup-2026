FACE_HOST=0.0.0.0
FACE_PORT=9000
FACE_DEBUG=false
ENV=development

# Leave empty in local dev to skip auth. Set a strong value in production.
FACE_API_KEY=

FACE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
FACE_MAX_UPLOAD_MB=8
FACE_RATE_LIMIT=60 per minute

FACE_VERIFY_THRESHOLD=0.45
FACE_IDENTIFY_THRESHOLD=0.40
FACE_LIVENESS_THRESHOLD=0.55
FACE_REQUIRE_LIVENESS_VERIFY=true
FACE_REQUIRE_LIVENESS_IDENTIFY=false

FACE_MIN_ENROLL_SAMPLES=3
FACE_MAX_ENROLL_SAMPLES=5
FACE_MIN_FACE_SIZE=80
FACE_MIN_SHARPNESS=35
FACE_INSIGHTFACE_MODEL=buffalo_s
FACE_DET_SIZE=640
