PORT=9100
DATABASE_URL=postgresql://user:password@localhost:5432/stt
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
STT_API_KEY=your-stt-service-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_REALTIME_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
CLAUDE_REFINER_MODEL=claude-sonnet-4-5-20250929
# Optional legacy; STT no longer uses OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key
MAX_AUDIO_BYTES=25000000
MAX_AUDIO_DURATION_SEC=720
ASYNC_DURATION_THRESHOLD_SEC=120
CONFIDENCE_FALLBACK_THRESHOLD=0.55
REALTIME_SKIP_SPEECH_GATE=true
RETAIN_AUDIO_DEFAULT=false
