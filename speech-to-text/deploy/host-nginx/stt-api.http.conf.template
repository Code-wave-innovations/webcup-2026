# Host nginx — phase 1 (before Let's Encrypt).
# Public :80 → Docker nginx on 127.0.0.1:__HTTP_PORT__

upstream stt_docker {
    server 127.0.0.1:__HTTP_PORT__;
}

map $http_upgrade $stt_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 30m;

    location / {
        proxy_pass http://stt_docker;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stt_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
