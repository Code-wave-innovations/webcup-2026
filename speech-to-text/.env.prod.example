# --- Public domain (create a NEW DuckDNS subdomain, e.g. webcup-stt) ---
DOMAIN=webcup-stt.duckdns.org
DUCKDNS_SUBDOMAIN=webcup-stt
DUCKDNS_TOKEN=your-duckdns-token
LETSENCRYPT_EMAIL=you@real-email.com

# Option 2: host nginx on :80/:443 → Docker on high ports
# (face-recognitions already uses 84 — use 85 here)
HTTP_PORT=85
HTTPS_PORT=448
FORCE_HTTP=1

# App
PORT=9100
STT_API_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=https://webcup-stt.duckdns.org,https://codewave.madagascar.webcup.hodi.cloud

# DB / queue (compose overrides hostnames to docker service names)
POSTGRES_USER=stt
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=stt
DATABASE_URL=postgresql://stt:change-me-strong-db-password@postgres:5432/stt
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Providers
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_STT_MODEL=openai/whisper-large-v3
OPENROUTER_REALTIME_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
CLAUDE_REFINER_MODEL=claude-sonnet-4-5-20250929

MAX_AUDIO_BYTES=25000000
MAX_AUDIO_DURATION_SEC=720
ASYNC_DURATION_THRESHOLD_SEC=120
CONFIDENCE_FALLBACK_THRESHOLD=0.55
REALTIME_SKIP_SPEECH_GATE=true
RETAIN_AUDIO_DEFAULT=false
